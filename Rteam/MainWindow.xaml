<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rteam.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rteam"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rteam">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  NavigationView  -->
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
    Title="Rteam"
    Subtitle="Preview"
    IsBackButtonVisible="False"
            
    IsPaneToggleButtonVisible="False">
            <TitleBar.RightHeader>
                <ComboBox PlaceholderText="No account">
                    <ComboBoxItem>sixer</ComboBoxItem>
                </ComboBox>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="nvSample"
IsSettingsVisible="False"
IsBackButtonVisible="Collapsed"
IsBackEnabled="False"
AlwaysShowHeader="False"
PaneTitle=""
IsPaneOpen="True"
PaneDisplayMode="Left"
ExpandedModeThresholdWidth="500"
SelectionFollowsFocus="Disabled"
IsTabStop="False"
                        IsPaneToggleButtonVisible="False"
      Grid.Row="1"
>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Roblox Home" Tag="1">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/Icons/RobloxIcon.png" ShowAsMonochrome="False"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Games"/>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel x:Name="FooterStackPanel" Orientation="Vertical" Visibility="Visible">
                    <NavigationViewItem Icon="Manage" Content="Manage Accounts"/>
                    <NavigationViewItem Icon="Add" Content="Add Game" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="contentFrame" />
        </NavigationView>
    </Grid>
    
</Window>
